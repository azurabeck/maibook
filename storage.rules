rules_version = '2';

// Regras de segurança do Firebase Storage para o MAIBOOK.
//
// Mesmo modelo de dono usado no firestore.rules: um arquivo dentro de
// projects/{projectId}/... só pode ser lido/escrito por quem é dono
// do documento projects/{projectId} no Firestore (cross-service rule
// via firestore.get()). Sem isso, qualquer pessoa autenticada
// poderia ler ou sobrescrever as imagens de qualquer livro só
// sabendo o id do projeto.
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;

      // na escrita, além de ser o dono, exige que seja uma imagem de
      // até 10MB (mesmo limite validado no client antes do upload)
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
